# Hillsview Corporate Website — Environment Configuration
# Copy this file to .env.local for serverless AI assistant integration (Vercel / Serverless Function).
# Never expose private AI API keys in VITE_* frontend variables.

# Server-side only (consumed by /api/chat.js serverless endpoint):
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Optional frontend override for custom serverless AI endpoint path (defaults to /api/chat):
VITE_AI_API_ENDPOINT=/api/chat

